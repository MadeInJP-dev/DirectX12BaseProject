  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
  <!--
    .cpp は自分の分類の PCH を使う(トップの Pch.h は外部ライブラリの .cpp だけ)。
      Source\Core\        -> Core/CorePCH.h
      Source\Engine\      -> Engine/EnginePCH.h(既定)
      Source\Application\ -> Application/AppPCH.h(main.cpp も)
      Source\Editor\      -> Editor/EditorPCH.h
    VS で .cpp を足すと既定(EnginePCH)になるので、Engine 以外に足したらここで止まる。
  -->
  <Target Name="CheckPch" BeforeTargets="ClCompile">
    <ItemGroup>
      <_PchMismatch Include="@(ClCompile)" Condition="$([System.String]::Copy('%(ClCompile.Identity)').StartsWith('Source\Core\')) And '%(ClCompile.PrecompiledHeaderFile)' != 'Core/CorePCH.h'" />
      <_PchMismatch Include="@(ClCompile)" Condition="$([System.String]::Copy('%(ClCompile.Identity)').StartsWith('Source\Engine\')) And '%(ClCompile.PrecompiledHeaderFile)' != 'Engine/EnginePCH.h'" />
      <_PchMismatch Include="@(ClCompile)" Condition="$([System.String]::Copy('%(ClCompile.Identity)').StartsWith('Source\Application\')) And '%(ClCompile.PrecompiledHeaderFile)' != 'Application/AppPCH.h'" />
      <_PchMismatch Include="@(ClCompile)" Condition="$([System.String]::Copy('%(ClCompile.Identity)').StartsWith('Source\Editor\')) And '%(ClCompile.PrecompiledHeaderFile)' != 'Editor/EditorPCH.h'" />
    </ItemGroup>
    <Error Condition="'@(_PchMismatch)' != ''" Text="分類の PCH を使っていない .cpp があります(vcxproj で PrecompiledHeaderFile / PrecompiledHeaderOutputFile / ForcedIncludeFiles を分類の PCH にすること): @(_PchMismatch)" />
  </Target>
  <!-- ライブラリ(Jolt / DirectXTK12 / DirectXTex / DirectXMesh)の PDB は Library/Lib/<構成> に置いてある。
       リンカーは .lib に記録された元のパスと出力先しか探さないので、リンクの前に出力先へ写す(LNK4099 を出さないため) -->
  <Target Name="CopyLibraryPdb" BeforeTargets="Link">
    <ItemGroup>
      <_LibraryPdb Include="$(ProjectDir)..\Library\Lib\$(Configuration)\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_LibraryPdb)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>