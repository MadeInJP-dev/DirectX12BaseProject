#========================================
# 共通無視フォルダ
#========================================
[Dd]ebug/
[Rr]elease/
packages/
Library/
.vs/

# ビルド出力(x64/Debug・x64/Release のほか、構成を足したときの x64/<構成名> もまとめて)
[Xx]64/

# 上の Debug/ Release/ はビルド出力のためのもの。
# ソースに同じ名前のフォルダ(Utility/Debug, Systems/Release など)があるので、
# Source 以下は管理対象へ戻す(戻さないとクローンしただけではビルドできない)
!BaseProject/Source/**/[Dd]ebug/
!BaseProject/Source/**/[Rr]elease/

#========================================
# 共通無視拡張子
#========================================
*.tlog
*.obj
*.pdb
*.ilk
*.idb
*.log
*.ipch
*.opendb
*.db
*.suo
*.inc
*.wpix


#========================================
# 個別設定
#========================================
imgui.ini

#========================================
#Asset（シェーダー以外除外）
#========================================
#Asset以下は基本的に無視
BaseProject/Asset/*
BaseProject/Imported/*

#管理対象指定
#Shader（コード扱い）
!BaseProject/Asset/Shader/
!BaseProject/Asset/Shader/**
#コンパイル済みシェーダー(.cso)はビルドで作り直すので除外
#(Debug / Release で中身が変わり、ビルドのたびに差分が出るため)
BaseProject/Asset/Shader/**/*.cso
#セーブデータ（あまりにも大きすぎたら消すかも）
!BaseProject/Asset/Data/
!BaseProject/Asset/Data/**

#Assetフォルダ自体は残す（空でも削除されないように）
!BaseProject/Asset/.gitkeep

